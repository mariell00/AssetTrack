{
  "name": "assettrack-desktop",
  "version": "1.0.0",
  "description": "AssetTrack - offline-first, portable asset management system (Retro Computing edition)",
  "main": "main.js",
  "author": "Supply Office / NBSC",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:mobile": "node scripts/build-mobile.js",
    "build:desktop": "npm run build:mobile && electron-builder",
    "tiles:fetch": "node src/features/mapping/tile-cache.js",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nbsc.assettrack",
    "productName": "AssetTrack",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "mobile/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "portable",
      "icon": "src/renderer/assets/icons/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/renderer/assets/icons/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/renderer/assets/icons/icon.png"
    }
  }
}
